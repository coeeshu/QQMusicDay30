<Window x:Class="QQDay30.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="每日30首捕捉器" Width="1080" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#121212" Foreground="#E6E6E6"
        FontFamily="Microsoft YaHei UI" FontSize="13" Icon="Assets/app.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#31C27C"/>
        <SolidColorBrush x:Key="Sub" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="Panel" Color="#1C1C1C"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" Background="#3A3A3A" CornerRadius="4"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="T" Property="Background" Value="#555"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" Background="Transparent" CornerRadius="8" Padding="12,9" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#242424"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#2C2C2C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- title bar: the sidebar runs up into it, the rest is drag area -->
        <Border Grid.RowSpan="2" Background="{StaticResource Panel}"/>
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
            <Image Source="Assets/app.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="每日30首" FontSize="15" FontWeight="Bold" Margin="9,0,0,1" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="最小化" Click="MinBtn_Click"/>
            <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="关闭到托盘" Click="CloseBtn_Click" Margin="4,0,0,0"/>
        </StackPanel>

        <!-- left: search + dates -->
        <DockPanel Grid.Row="1">
            <StackPanel DockPanel.Dock="Top" Margin="14,6,14,8">
                <TextBlock x:Name="CountText" Foreground="{StaticResource Sub}" Margin="2,0,0,10"/>
                <Border Background="#2A2A2A" CornerRadius="15" Padding="12,6">
                    <Grid>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="#E6E6E6"
                                 CaretBrush="#E6E6E6" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="搜索历史里的歌名 / 歌手" Foreground="#666" IsHitTestVisible="False"
                                   x:Name="SearchHint"/>
                    </Grid>
                </Border>
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="14,8,14,12" LastChildFill="False">
                <CheckBox x:Name="AutoStartBox" DockPanel.Dock="Top" Content="开机自动启动（托盘后台）" Foreground="{StaticResource Sub}"
                          Margin="0,0,0,6" Click="SettingBox_Click"/>
                <CheckBox x:Name="FollowQQBox" DockPanel.Dock="Top" Content="打开QQ音乐时弹出本窗口" Foreground="{StaticResource Sub}"
                          Click="SettingBox_Click"/>
            </DockPanel>
            <ListBox x:Name="DateList" Background="Transparent" BorderThickness="0" Margin="8,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="DateList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" FontSize="14"/>
                            <TextBlock Text="{Binding Week}" Foreground="#777" Margin="8,1,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- right: detail -->
        <DockPanel Grid.Row="1" Grid.Column="1" Margin="28,2,20,0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" Text="还没有记录"/>
                <TextBlock x:Name="SubText" Foreground="{StaticResource Sub}" Margin="0,6,0,14"/>
                <WrapPanel Margin="0,0,0,14">
                    <Button x:Name="PlayBtn" Style="{StaticResource Primary}" Content="▶  放到工作区歌单并打开QQ音乐" Click="PlayBtn_Click"/>
                    <Button x:Name="SaveAsBtn" Content="另存为独立歌单" Click="SaveAsBtn_Click"/>
                    <Button x:Name="CaptureBtn" Content="立即捕获今天" Click="CaptureBtn_Click"/>
                </WrapPanel>
            </StackPanel>

            <ListView x:Name="SongList" Background="Transparent" BorderThickness="0" Foreground="#E6E6E6"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="B" Background="Transparent" CornerRadius="6" Padding="8,6">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="Background" Value="#1F1F1F"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="B" Property="Background" Value="#262626"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Index}" Foreground="#777" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Width="40" Height="40" CornerRadius="4" HorizontalAlignment="Left" Background="#2A2A2A">
                                <Border.OpacityMask>
                                    <VisualBrush>
                                        <VisualBrush.Visual>
                                            <Border Width="40" Height="40" CornerRadius="4" Background="White"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Border.OpacityMask>
                                <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Song.Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Song.Singers}" Foreground="{StaticResource Sub}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding Song.Album}" Foreground="{StaticResource Sub}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="4" Text="{Binding DateLabel}" Foreground="#777" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="{Binding Song.DurationText}" Foreground="{StaticResource Sub}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#181818" Padding="14,6">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Sub}" Text="就绪"/>
        </Border>
    </Grid>
</Window>
