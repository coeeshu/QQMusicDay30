<Window x:Class="QQDay30.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QQDay30"
        Title="每日30首捕捉器" Width="1080" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Microsoft YaHei UI" FontSize="13" Icon="Assets/app.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#31C27C"/>
        <Duration x:Key="Fast">0:0:0.16</Duration>
        <QuarticEase x:Key="Out" EasingMode="EaseOut"/>

        <!-- pill button: hover/press fade a white overlay, press squeezes slightly -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform/>
                            </Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" CornerRadius="17"/>
                            <Border x:Name="Over" Background="{DynamicResource Overlay}" CornerRadius="17" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Over" Storyboard.TargetProperty="Opacity" To="0.08" Duration="{StaticResource Fast}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Over" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.96" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.96" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" Background="{DynamicResource ScrollThumb}" CornerRadius="4" Opacity="0.7"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="T" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Fast}"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="T" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.3"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- date list item: fading hover, accent bar that grows when selected -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,1">
                            <Border x:Name="Hover" Background="{DynamicResource Overlay}" CornerRadius="8" Opacity="0"/>
                            <Border x:Name="Sel" Background="{DynamicResource Overlay}" CornerRadius="8" Opacity="0"/>
                            <Rectangle x:Name="Bar" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Accent}"
                                       HorizontalAlignment="Left" Margin="4,0,0,0" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleY="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <ContentPresenter Margin="16,10,12,10"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.04" Duration="{StaticResource Fast}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1"
                                                             Duration="0:0:0.4" EasingFunction="{StaticResource Out}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0"
                                                             Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- song row: fading hover, staggered entrance driven from code -->
        <Style x:Key="SongItem" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <EventSetter Event="Loaded" Handler="SongItem_Loaded"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid>
                            <Border x:Name="Hover" Background="{DynamicResource Overlay}" CornerRadius="8" Opacity="0"/>
                            <ContentPresenter Margin="8,6"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.045" Duration="{StaticResource Fast}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="30" Height="17" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="8.5" Background="{DynamicResource Track}"/>
                                <Border x:Name="On" CornerRadius="8.5" Background="{StaticResource Accent}" Opacity="0"/>
                                <Ellipse x:Name="Knob" Width="13" Height="13" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="RenderTransform.X" To="13"
                                                             Duration="0:0:0.3" EasingFunction="{StaticResource Out}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="RenderTransform.X" To="0"
                                                             Duration="0:0:0.3" EasingFunction="{StaticResource Out}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- sidebar background runs up into the title bar -->
        <Border Grid.RowSpan="2" Background="{DynamicResource Panel}"/>

        <StackPanel x:Name="Brand" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
            <Image Source="Assets/app.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="每日30首" FontSize="15" FontWeight="Bold" Margin="9,0,0,1" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
            <local:ThemeSwitch x:Name="ThemeSwitcher" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="最小化" Click="MinBtn_Click"/>
            <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="关闭到托盘" Click="CloseBtn_Click" Margin="4,0,0,0"/>
        </StackPanel>

        <!-- indeterminate loading bar under the title bar -->
        <Canvas x:Name="LoadingBar" Grid.Row="0" Grid.ColumnSpan="2" Height="2" VerticalAlignment="Bottom"
                ClipToBounds="True" Opacity="0" IsHitTestVisible="False">
            <Rectangle x:Name="LoadingDash" Width="220" Height="2" RadiusX="1" RadiusY="1">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0031C27C" Offset="0"/>
                        <GradientStop Color="#FF31C27C" Offset="0.5"/>
                        <GradientStop Color="#0031C27C" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                    <TranslateTransform/>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Canvas>

        <!-- left: search + dates -->
        <DockPanel x:Name="Sidebar" Grid.Row="1">
            <StackPanel DockPanel.Dock="Top" Margin="14,6,14,8">
                <TextBlock x:Name="CountText" Foreground="{DynamicResource Sub}" Margin="2,0,0,10"/>
                <Border x:Name="SearchBorder" Background="{DynamicResource Card2}" CornerRadius="16" Padding="13,7" BorderThickness="1" BorderBrush="#00000000">
                    <Grid>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Fg}"
                                 CaretBrush="#31C27C" TextChanged="SearchBox_TextChanged"
                                 GotKeyboardFocus="SearchBox_Focus" LostKeyboardFocus="SearchBox_Focus"/>
                        <TextBlock Text="搜索历史里的歌名 / 歌手" Foreground="{DynamicResource Placeholder}" IsHitTestVisible="False"
                                   x:Name="SearchHint"/>
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="16,8,14,14">
                <CheckBox x:Name="AutoStartBox" Content="开机自动启动" Margin="0,0,0,10" Click="SettingBox_Click"/>
                <CheckBox x:Name="FollowQQBox" Content="打开QQ音乐时弹出" Click="SettingBox_Click"/>
            </StackPanel>
            <ListBox x:Name="DateList" Background="Transparent" Foreground="{DynamicResource Fg}" BorderThickness="0" Margin="8,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                     local:SmoothScroll.IsEnabled="True" SelectionChanged="DateList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" FontSize="14"/>
                            <TextBlock Text="{Binding Week}" Foreground="{DynamicResource Muted}" Margin="8,1,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- right: detail -->
        <DockPanel Grid.Row="1" Grid.Column="1" Margin="28,2,20,0">
            <StackPanel x:Name="Header" DockPanel.Dock="Top">
                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="Bold" Text="还没有记录"/>
                <TextBlock x:Name="SubText" Foreground="{DynamicResource Sub}" Margin="0,6,0,16"/>
                <WrapPanel x:Name="Actions" Margin="0,0,0,14">
                    <Button x:Name="PlayBtn" Style="{StaticResource Primary}" Content="▶  放到工作区歌单并打开QQ音乐" Click="PlayBtn_Click"/>
                    <Button x:Name="SaveAsBtn" Content="另存为独立歌单" Click="SaveAsBtn_Click"/>
                    <Button x:Name="CaptureBtn" Content="立即同步" ToolTip="捕获今天的每日30首，并从手机端的历史推荐补回最近几天" Click="CaptureBtn_Click"/>
                </WrapPanel>
            </StackPanel>

            <ListView x:Name="SongList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Fg}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                      local:SmoothScroll.IsEnabled="True" ItemContainerStyle="{StaticResource SongItem}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Index}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Width="42" Height="42" CornerRadius="6" HorizontalAlignment="Left" Background="{DynamicResource Card}">
                                <Border.OpacityMask>
                                    <VisualBrush>
                                        <VisualBrush.Visual>
                                            <Border Width="42" Height="42" CornerRadius="6" Background="{DynamicResource Overlay}"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Border.OpacityMask>
                                <Image Source="{Binding Cover}" Stretch="UniformToFill" Opacity="0" x:Name="CoverImg"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Song.Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Song.Singers}" Foreground="{DynamicResource Sub}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding Song.Album}" Foreground="{DynamicResource Sub}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="4" Text="{Binding DateLabel}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="{Binding Song.DurationText}" Foreground="{DynamicResource Sub}" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- covers fade in once downloaded -->
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasCover}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CoverImg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>

        <!-- toast -->
        <Border x:Name="Toast" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,18" Padding="18,10" CornerRadius="20" Background="{DynamicResource ToastBg}" Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ToastDot" Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToastText" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource StatusBg}" Padding="14,6">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" Text="就绪" FontSize="12"/>
        </Border>

        <!-- snapshot of the old theme; a growing circular hole reveals the new theme underneath -->
        <Image x:Name="ThemeOverlay" Grid.RowSpan="3" Grid.ColumnSpan="2" Stretch="None" HorizontalAlignment="Left"
               VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed" Panel.ZIndex="100"/>
    </Grid>
</Window>
