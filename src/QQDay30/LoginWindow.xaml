<Window x:Class="QQDay30.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="登录QQ音乐 - 每日30首捕捉器" Width="1000" Height="720"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="Hint" Foreground="#31C27C" FontSize="14" Margin="12,8"
                   Text="请点击网页右上角「登录」，用QQ或微信扫码。登录成功后此窗口会自动关闭。"/>
        <wv2:WebView2 x:Name="Web"/>
    </DockPanel>
</Window>
