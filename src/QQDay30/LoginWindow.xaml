<Window x:Class="QQDay30.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="登录QQ音乐 - 每日30首" Width="1000" Height="720"
        WindowStartupLocation="CenterScreen" Background="#1C1C1C" Foreground="#E6E6E6"
        FontFamily="Microsoft YaHei UI" Icon="Assets/app.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="44">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image Source="Assets/app.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="登录QQ音乐" FontSize="15" FontWeight="Bold" Margin="9,0,0,1" VerticalAlignment="Center"/>
                <TextBlock x:Name="Hint" Foreground="#31C27C" FontSize="13" Margin="18,1,0,0" VerticalAlignment="Center"
                           Text="点击网页右上角「登录」，用QQ或微信扫码，登录成功后窗口会自动关闭"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="最小化"
                        Click="MinBtn_Click"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="关闭"
                        Click="CloseBtn_Click" Margin="4,0,0,0"/>
            </StackPanel>
        </Grid>
        <wv2:WebView2 x:Name="Web"/>
    </DockPanel>
</Window>
